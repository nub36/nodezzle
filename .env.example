# ============================================================
# NODEZZLE — пример переменных окружения
# ============================================================
# Скопируйте этот файл в `.env` и заполните реальными значениями
# локально. Файл `.env` игнорируется Git'ом (см. .gitignore).
#
# ПРАВИЛО: в репозитории НИКОГДА не появляются реальные:
#   - Telegram Bot Token;
#   - API keys;
#   - пароли и credentials базы данных;
#   - GitHub tokens;
#   - JWT secrets;
#   - encryption / session secrets;
#   - содержимое production .env.
#
# В этом файле разрешены только НАЗВАНИЯ переменных и
# безопасные фиктивные значения.

# ------------------------------------------------------------
# Telegram (будущий backend-интеграционный слой)
# Токен бота хранится ТОЛЬКО на сервере (backend), не во frontend.
# ------------------------------------------------------------
NODEZZLE_TELEGRAM_BOT_TOKEN=123456:EXAMPLE-FIXTURE-DO-NOT-USE
NODEZZLE_TELEGRAM_PROXY_URL=

# ------------------------------------------------------------
# AI (будущая интеграция: генерация схем, анализ ошибок)
# ------------------------------------------------------------
NODEZZLE_AI_API_KEY=sk-example-fixture-do-not-use
NODEZZLE_AI_MODEL=example-model

# ------------------------------------------------------------
# Backend API (будущий сервер NODEZZLE)
# На этапе MVP хранилище — localStorage браузера (ProjectStorage),
# API появится на следующих этапах (см. docs/ROADMAP.md).
# ------------------------------------------------------------
NODEZZLE_API_URL=http://localhost:3001/api

# ------------------------------------------------------------
# Секреты сервера (будущий backend)
# ------------------------------------------------------------
NODEZZLE_JWT_SECRET=change-me-in-production
NODEZZLE_ENCRYPTION_KEY=change-me-in-production
NODEZZLE_SESSION_SECRET=change-me-in-production

# ------------------------------------------------------------
# База данных (будущий backend)
# ------------------------------------------------------------
NODEZZLE_DATABASE_URL=postgres://user:password@example.invalid:5432/nodezzle
